{{- $name  := promptStringOnce . "name"  "Full name for git commits" -}}
{{- $email := promptStringOnce . "email" "Email for git commits" -}}
{{- $desktop := promptStringOnce . "desktop" "Desktop session (plasma/hyprland/niri/none)" "plasma" -}}

[data]
    name    = {{ $name | quote }}
    email   = {{ $email | quote }}
    desktop = {{ $desktop | quote }}

{{- $name  := promptStringOnce . "name"  "Full name for git commits" -}}
{{- $email := promptStringOnce . "email" "Email for git commits" -}}
{{- /*
     NB: promptStringOnce only asks when the key is ABSENT from
     ~/.config/chezmoi/chezmoi.toml, so carrying that file across from another
     machine silently keeps the old answer and never prompts. Force it with:
         chezmoi init --promptString desktop=plasma
*/ -}}
{{- $desktop := promptStringOnce . "desktop" "Desktop session (plasma/none)" "plasma" -}}
{{- /*
     Hostname of a private/work git forge. Read by scripts/git-credentials.sh,
     which stores a PAT for it alongside the github.com one.

     Kept out of the repo on purpose: this repo is public (see
     scripts/secrets-setup.sh), and a hostname is inventory disclosure even
     though it is not a credential. Leave BLANK if you have none - the script
     then just does github.com, and `--host` adds any other on the fly.
*/ -}}
{{- /*
     Which machine is this. Two keys, because the answers are independent: a
     GPU vendor is not a chassis type.

     NB: deliberately NOT .chezmoi.hostname, which is what chezmoi's own docs
     reach for. This repo is public and already treats a hostname as inventory
     disclosure - that is the whole reason workGitHost below is prompted rather
     than committed. Chassis and PCI vendor id say what the machine IS without
     saying which machine it is.

     NB: `output` runs the command EVERY time the template is executed. That is
     acceptable here and nowhere else: this file is executed only at
     `chezmoi init`, and the answers are then baked into [data] below. Do not
     copy this pattern into a per-file template - it would fork a shell on
     every single `chezmoi apply`.

     NB: because they ARE baked, swapping a GPU leaves `gpu` stale and nothing
     would notice - the wrong LIBVA_DRIVER_NAME does not error, it just kills
     VA-API. So scripts/doctor.sh re-reads the PCI id live and fails when it
     disagrees with the value stored here.

     bootstrap.sh passes both with --promptString, so lib/detect.sh is the
     single decision-maker and these defaults only apply to a bare
     `chezmoi init`. Force a re-answer with:
         chezmoi init --promptString profile=desktop
*/ -}}
{{- $autoProfile := output "sh" "-c" "if [ -e /sys/class/power_supply/BAT0 ]; then echo laptop; else case \"$(cat /sys/class/dmi/id/chassis_type 2>/dev/null)\" in 8|9|10|11|14) echo laptop ;; *) echo desktop ;; esac; fi" | trim -}}
{{- $autoGpu := output "sh" "-c" "g=none; grep -qs 0x8086 /sys/class/drm/card*/device/vendor && g=intel; grep -qs 0x1002 /sys/class/drm/card*/device/vendor && g=amd; grep -qs 0x10de /sys/class/drm/card*/device/vendor && g=nvidia; echo $g" | trim -}}
{{- $profile := promptStringOnce . "profile" "Machine profile (laptop/desktop)" $autoProfile -}}
{{- $gpu := promptStringOnce . "gpu" "GPU vendor (intel/amd/nvidia/none)" $autoGpu -}}
{{- /*
     Hostname of a private/work git forge (continued below).
*/ -}}
{{- $workGitHost := promptStringOnce . "workGitHost" "Private git host for the generic credential helper (blank for none)" "" -}}

# Pin the source directory into the generated config.
#
# WHY: this repo is cloned wherever you keep it (~/dotfiles, ~/Documents/...),
# never chezmoi's default ~/.local/share/chezmoi. bootstrap.sh passes
# `--source "$REPO"` so IT works, but nothing recorded the path, so every bare
# chezmoi command afterwards - apply, diff, add, re-add, update - looked in the
# default location, found nothing, and failed. `chezmoi doctor` said
# "error source-dir: open ~/.local/share/chezmoi: no such file or directory"
# on a machine that was otherwise fully set up.
#
# NB: .chezmoi.sourceDir is resolved AFTER .chezmoiroot, so this stores
# <repo>/home, which is the correct value - chezmoi then reads the source state
# straight from there with no second .chezmoiroot hop.
#
# NB: it is baked at `chezmoi init` time. Move the repo and re-run
# `chezmoi init --source <new path>`.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    name    = {{ $name | quote }}
    email   = {{ $email | quote }}
    desktop = {{ $desktop | quote }}
    profile = {{ $profile | quote }}
    gpu     = {{ $gpu | quote }}
    workGitHost = {{ $workGitHost | quote }}

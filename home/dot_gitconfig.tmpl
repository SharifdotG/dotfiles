[user]
	name = {{ .name }}
	email = {{ .email }}

[init]
	defaultBranch = main
[pull]
	rebase = true
[core]
	editor = code-insiders --wait
	# Large monorepos: these three make status/diff noticeably faster.
	fsmonitor = true
	untrackedCache = true
[feature]
	manyFiles = true
[index]
	# NB: manyFiles implies index.skipHash=true, which writes an index with a
	# zeroed trailing checksum. Git itself is fine with it; libgit2 is not, and
	# GitKraken (configured in the VS Code settings, and installed here as
	# ~/.local/share/GitKrakenCLI) is a libgit2 client - it fails to open the
	# repo with a checksum error that reads like corruption. Pin it off
	# explicitly rather than inheriting it from the feature bundle.
	skipHash = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Machine-local credential config, written by scripts/git-credentials.sh.
#
# It names the credential helper; the tokens themselves live in the keyring, so
# neither the secret nor this include's contents are ever in the repo. It is a
# separate file because `git config --global` writes THIS file, which chezmoi
# regenerates - anything the script wrote here would vanish at the next apply.
#
# NB: git silently ignores an include path that does not exist (verified), so a
# machine that has never run the script is not broken by this line.
#
# NB: this must be the LAST include - git applies included values where the
# include appears, so anything after it would win over the helper.
[include]
	path = ~/.config/git/credentials.inc

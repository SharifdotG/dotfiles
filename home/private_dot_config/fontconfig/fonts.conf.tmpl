<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  System font policy. Two jobs, kept separate below:
    1. WHICH font answers the generic families (sans-serif / serif / monospace)
    2. HOW glyphs are rasterised, per panel density

  NB: this file is the fontconfig half only. Plasma does NOT read it to pick its
  own UI font - KDE stores that in kdeglobals, and it is set alongside this by
  .chezmoiscripts/run_onchange_after_20-kde-theme.sh. Both have to agree, so if
  you change a family here, change it there too.

  NB: ~/.config/fontconfig/fonts.conf is the USER file and is read AFTER
  /etc/fonts/conf.d/*. Its <match> rules therefore win over the distro defaults
  (including CachyOS's), which is exactly why the config lives here and not in
  /etc - no root, no drop-in ordering games.
-->
<fontconfig>

  <!-- ── 1. Generic family bindings ─────────────────────────────────────────

       binding="strong" matters. With the default weak binding, a request that
       already carries a family (which is most of them - Qt and GTK both send
       one) keeps its own and these prepends are ignored, so the desktop only
       half-changes font. Strong binding makes ours sort first regardless.
  -->
  <match target="pattern">
    <test qual="any" name="family"><string>sans-serif</string></test>
    <edit name="family" mode="prepend" binding="strong"><string>Adwaita Sans</string></edit>
  </match>
  <match target="pattern">
    <test qual="any" name="family"><string>sans</string></test>
    <edit name="family" mode="prepend" binding="strong"><string>Adwaita Sans</string></edit>
  </match>

  <!-- Adwaita ships no serif face. Everything except monospace is Adwaita Sans
       per the request, so serif resolves there too rather than falling through
       to whatever Noto the fontconfig defaults would pick.

       NB, 2026-09-06: this rule DOES NOT REACH CHROMIUM, and the browser was
       rendering `font-family: serif` as Liberation Serif while this file said
       otherwise. Blink does not ask fontconfig for the generic families at all
       - it maps CSS serif/sans-serif/monospace to its OWN prefs
       (webkit.webprefs.fonts.{serif,sansserif,fixed}.Zyyy) and only then asks
       fontconfig for that concrete family name. So a browser needs the same
       decision written a second time, in its own profile. That is what
       .chezmoiscripts/run_after_50-brave-fonts.sh does; keep the two in step
       the same way this file and kdeglobals are kept in step. -->
  <match target="pattern">
    <test qual="any" name="family"><string>serif</string></test>
    <edit name="family" mode="prepend" binding="strong"><string>Adwaita Sans</string></edit>
  </match>

  <!-- The family string is "CaskaydiaCove Nerd Font", and getting it wrong is
       silent. CORRECTION, 2026-09-04: this file, Ghostty, VS Code and the KDE
       theme script all asked for "Cascadia Code NF" - a family that does not
       exist on this machine.

       `ttf-cascadia-code-nerd` is the Arch package name; the FONTS inside it
       are Nerd Fonts' patch of Cascadia Code, and the patch renames the family
       to Caskaydia Cove. The package ships CaskaydiaCoveNerdFont-*.ttf and
       registers exactly these families:
           CaskaydiaCove Nerd Font        <- used here (icons at design width)
           CaskaydiaCove Nerd Font Mono   <- icons squeezed into one cell
           CaskaydiaCove Nerd Font Propo  <- proportional, not for terminals
       plus "CaskaydiaCove NF" / "NFM" / "NFP" as abbreviated aliases of the
       same files. The abbreviated names ALSO register each weight as its own
       family ("CaskaydiaCove NF SemiLight", ...), so the full name is the one
       that resolves weights cleanly. Verified:
           fc-match 'CaskaydiaCove Nerd Font:weight=bold' -> ...-Bold.ttf

       And the failure mode is why this comment is this long:
           fc-match 'Cascadia Code NF'   ->  AdwaitaSans-Regular.ttf
       fontconfig does not fail on an unknown family, it substitutes. So the
       monospace generic was resolving to a PROPORTIONAL sans and everything
       still rendered - just wrong, with no error anywhere.

       Non-Mono is deliberate: Starship's powerline separators and eza's icons
       are drawn at their design width, and Ghostty and Konsole both handle a
       wide glyph correctly. Switch to "CaskaydiaCove Nerd Font Mono" only if
       some app turns out to assume every glyph is one cell. -->
  <match target="pattern">
    <test qual="any" name="family"><string>monospace</string></test>
    <edit name="family" mode="prepend" binding="strong"><string>CaskaydiaCove Nerd Font</string></edit>
  </match>

  <!-- Emoji and CJK still need a real fallback after the prepends above, or a
       missing glyph stops at Adwaita Sans and draws a box. packages/desktop.tsv
       installs both Noto families for exactly this. -->
  <match target="pattern">
    <test qual="any" name="family"><string>sans-serif</string></test>
    <edit name="family" mode="append" binding="weak"><string>Noto Sans</string></edit>
    <edit name="family" mode="append" binding="weak"><string>Noto Sans CJK SC</string></edit>
    <edit name="family" mode="append" binding="weak"><string>Noto Color Emoji</string></edit>
  </match>
  <match target="pattern">
    <test qual="any" name="family"><string>monospace</string></test>
    <edit name="family" mode="append" binding="weak"><string>Noto Sans Mono</string></edit>
    <edit name="family" mode="append" binding="weak"><string>Noto Color Emoji</string></edit>
  </match>

  <!-- The CSS generic keywords. Plain aliases, and they work - verified:

           $ fc-match 'ui\-monospace'   ->  CaskaydiaCoveNerdFont-Regular.ttf
           $ fc-match 'system\-ui'      ->  AdwaitaSans-Regular.ttf

       NB: THE BACKSLASH IS NOT OPTIONAL, and this cost an hour on 2026-09-05.
       fc-match parses its argument as a FONT PATTERN, where an unescaped "-"
       begins the size/style section. So

           $ fc-match ui-monospace

       does not ask for the family "ui-monospace" at all - it asks for the
       family "ui", which matches nothing and substitutes to Adwaita Sans. That
       reads exactly like "the ui-monospace alias is broken and code blocks are
       rendering in a proportional font", and it is purely an artefact of how
       the question was asked. Confirmed with FC_DEBUG=4, which shows the
       request pattern as family: "ui".

       Same trap for any hyphenated family: system-ui, ui-sans-serif, and
       -apple-system (which additionally needs a bare `fc-match` end-of-options
       marker, because getopt eats the leading dash). scripts/doctor.sh escapes them for this reason.
       Do not "fix" these aliases; there is nothing wrong with them. -->
  <alias><family>system-ui</family><prefer><family>Adwaita Sans</family></prefer></alias>
  <alias><family>ui-monospace</family><prefer><family>CaskaydiaCove Nerd Font</family></prefer></alias>

  <!-- The rest of the CSS/web font keywords. ADDED 2026-09-06, and the reason
       they are not optional is that `fc-match` CANNOT SEE THE BUG THEY FIX.

       Before this block, fc-match answered Adwaita Sans for every name below -
       so by the only test this file had, nothing was wrong:

           $ fc-match 'ui\-sans\-serif'    ->  AdwaitaSans-Regular.ttf
           $ fc-match '\-apple\-system'    ->  AdwaitaSans-Regular.ttf
             (the second needs an end-of-options marker before the pattern,
              per the note above; it cannot be written literally here because
              a double dash is not legal inside an XML comment - which is
              itself how this file got broken once, see the NB at the end)

       But that answer is fontconfig SUBSTITUTING for a family it does not
       know, not fontconfig MATCHING one. fc-match reports the substitution and
       looks correct; Chromium asks the same question through
       FontConfigDirect::MatchFamilyName, which REJECTS a result whose family
       is not a real match for the request, and falls back to the browser's own
       "Standard font" pref instead. Measured in Brave (headless, real profile,
       CSS.getPlatformFontsForNode reporting the face actually used to draw):

           font-family: -apple-system              ->  Liberation Serif
           font-family: BlinkMacSystemFont         ->  Liberation Serif
           font-family: ui-sans-serif              ->  Liberation Serif
           -apple-system, BlinkMacSystemFont,
             'Segoe UI', Roboto                    ->  Liberation Serif

       A SERIF face, on the stack half the web ships. system-ui and
       ui-monospace above were already fine precisely because they have an
       explicit <alias> - that is what makes the match strong enough for
       Chromium to accept. The names below just need the same treatment. After:

           all four  ->  Adwaita Sans

       NB: THE TEST FOR THIS IS THE BROWSER, NOT fc-match. If these ever look
       broken again, probe the browser; fc-match will keep saying it is fine.

       NB: NEVER WRITE A DOUBLE DASH IN A COMMENT IN THIS FILE. XML forbids it
       inside a comment body, and fontconfig's reaction is the worst possible
       one: it prints
           Fontconfig error: ".../fonts.conf", line NNN: not well-formed
       to stderr - where a desktop session sends it nowhere - and then IGNORES
       THE ENTIRE FILE. Not the bad comment, the whole config. Every binding
       above silently stops existing and the machine falls back to the
       fontconfig defaults, so sans-serif becomes Noto Sans and the desktop
       quietly changes font. Introduced and caught on 2026-09-06 by writing
       `fc-match` with its end-of-options marker in the block above.
       The check is one command, and it is worth running after ANY edit here:
       `xmllint` with its noout flag, against the RENDERED file in ~/.config.
       scripts/doctor.sh runs exactly that, for exactly this reason.

       NB: Arial and Helvetica are deliberately NOT here. They resolve to
       Liberation Sans via /etc/fonts/conf.d/30-metric-aliases.conf, which is
       correct and wanted: a page asking for Arial by name is asking for those
       metrics, and Liberation Sans is the metric-compatible face. Only the
       "give me the system font" keywords belong in this block. -->
  <alias><family>ui-sans-serif</family><prefer><family>Adwaita Sans</family></prefer></alias>
  <alias><family>ui-serif</family><prefer><family>Adwaita Sans</family></prefer></alias>
  <alias><family>ui-rounded</family><prefer><family>Adwaita Sans</family></prefer></alias>
  <alias><family>-apple-system</family><prefer><family>Adwaita Sans</family></prefer></alias>
  <alias><family>BlinkMacSystemFont</family><prefer><family>Adwaita Sans</family></prefer></alias>

  <!-- ── 2. Rasterisation, per panel ────────────────────────────────────────

       NB, AND THIS IS THE IMPORTANT ONE: THIS FILE IS NOT THE LAST WORD.
       Plasma's Fonts settings module (kcm_fonts.so - it carries the strings
       XftHintStyle, hintstyle, rgba) re-serialises this exact file and APPENDS
       its own <match target="font"> block instead of replacing one. Measured on
       2026-09-05, on a machine where every config file said hintslight:

           $ grep -c 'match target="font"' ~/.config/fontconfig/fonts.conf
           33
           $ fc-match -f '%{hintstyle} %{hinting} %{rgba}' sans-serif
           0 False 5            # = hintnone, hinting off, subpixel off

       target="font" edits with mode="assign" and no test all fire, in document
       order, so the LAST block wins - and the last block was Plasma's. The
       machine had been rendering with hinting and subpixel antialiasing off for
       an unknown length of time. Nothing errored. `chezmoi status` showed
       " M .config/fontconfig/fonts.conf" and nothing read it.

       Two consequences, both load-bearing:
         - `chezmoi apply` repairs it, because chezmoi owns the whole file.
           Re-run it after any visit to System Settings -> Fonts.
         - The values below are ALSO written to kdeglobals as XftAntialias /
           XftHintStyle / XftSubPixel by .chezmoiscripts/20-kde-theme.sh,
           because the KCM regenerates this file FROM those keys. That is how a
           correct value survives the round trip. Change one, change both.
       scripts/doctor.sh now reads the effective values back with fc-match
       instead of trusting this file.

       Two machines, two densities, and the values below are chosen for the
       density - not for the machine:

         laptop   14" 1920x1080  = ~157 ppi
         desktop  21.5" 1920x1080 = ~102 ppi (primary, right)
                  18.5" 1366x768  = ~85 ppi  (secondary, left)
                  both at 100% scale, so one setting has to serve both

       NB: it is the same setting on both machines today, and that is a
       finding, not laziness - see the hintstyle note below. The block is
       templated anyway because the reasoning differs at each end and the
       desktop is the density where someone WILL want to flip it.
  -->
  <match target="font">
    <edit name="antialias" mode="assign"><bool>true</bool></edit>

{{- if eq .profile "laptop" }}
    <!-- hintslight, NOT hintfull. Full hinting snaps stems to the pixel grid,
         which at 157 ppi visibly distorts letterforms and wrecks spacing.
         Slight hinting only aligns vertically, keeping the designed shape -
         and it is what Adwaita Sans (an Inter derivative) and Cascadia
         Code are both drawn for. hintnone would be blurry. -->
{{- else }}
    <!-- Still hintslight at ~85-102 ppi, which is NOT the obvious answer -
         low DPI is exactly where full hinting is traditionally recommended.
         It loses here for two reasons that are specific to this stack:
         autohint is off (below), so hintfull hands the work to each font's
         own bytecode interpreter, and both fonts in use are drawn for slight
         hinting; and Qt/Plasma render with subpixel POSITIONING, which
         hintfull's integer stem snapping fights rather than helps.
         If text looks soft on the 18.5" panel, this const is the one knob to
         change - hintfull, nothing else. Change it and re-log-in; fontconfig
         is read at process start, so already-running apps will not update. -->
{{- end }}
    <edit name="hinting" mode="assign"><bool>true</bool></edit>
    <edit name="hintstyle" mode="assign"><const>hintslight</const></edit>

    <!-- autohint OFF is not a typo: with hintslight, FreeType's own
         interpreter beats the autohinter on fonts that ship good hints, and
         both of ours do. Turning it on here is the classic "fonts look wrong
         and I don't know why" setting. -->
    <edit name="autohint" mode="assign"><bool>false</bool></edit>

    <!-- Subpixel rendering. rgb is the stripe order on every panel this repo
         has met - the T490s eDP, and both desktop monitors. On a ROTATED
         display it would need vrgb, or "none". lcddefault is the light FIR
         filter that kills the colour fringing subpixel AA otherwise leaves on
         stem edges.
         NB: fontconfig cannot vary this per output. It is a process-wide
         setting, so a mixed-orientation setup has to pick one or turn
         subpixel off entirely. Both desktop monitors are landscape, so rgb
         is right for both. -->
    <edit name="rgba" mode="assign"><const>rgb</const></edit>
    <edit name="lcdfilter" mode="assign"><const>lcddefault</const></edit>

    <!-- Some fonts carry low-res bitmap strikes for small sizes. Those strikes
         were drawn for ~96 ppi CRT-era screens and are worse than the outline
         at every density in use here, 157 and 102 alike. -->
    <edit name="embeddedbitmap" mode="assign"><bool>false</bool></edit>
  </match>

</fontconfig>

# Catppuccin Latte for micro.
# NB: micro/settings.json has named this colorscheme since the repo was created,
# but nothing ever shipped it - micro silently fell back to its default. This
# file closes that dangling reference.
color-link default "#4c4f69,#eff1f5"
color-link comment "#9ca0b0"
color-link constant "#fe640b"
color-link constant.number "#fe640b"
color-link constant.string "#40a02b"
color-link constant.string.char "#40a02b"
color-link constant.bool "#fe640b"
color-link identifier "#1e66f5"
color-link identifier.class "#df8e1d"
color-link identifier.var "#4c4f69"
color-link statement "#8839ef"
color-link symbol "#179299"
color-link symbol.brackets "#4c4f69"
color-link symbol.operator "#179299"
color-link preproc "#e64553"
color-link type "#df8e1d"
color-link type.keyword "#8839ef"
color-link special "#d20f39"
color-link error "bold #eff1f5,#d20f39"
color-link todo "bold #eff1f5,#df8e1d"
color-link statusline "#4c4f69,#ccd0da"
color-link tabbar "#4c4f69,#ccd0da"
color-link indent-char "#acb0be"
color-link line-number "#8c8fa1,#e6e9ef"
color-link current-line-number "#1e66f5,#e6e9ef"
color-link diff-added "#40a02b"
color-link diff-modified "#df8e1d"
color-link diff-deleted "#d20f39"
color-link gutter-error "#d20f39"
color-link gutter-warning "#df8e1d"
color-link cursor-line "#e6e9ef"
color-link color-column "#e6e9ef"
color-link selection "#4c4f69,#bcc0cc"

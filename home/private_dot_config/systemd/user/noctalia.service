# Noctalia ships only a .desktop file - no systemd unit. Starting it from niri's
# spawn-at-startup would make it an unsupervised child of the compositor, which
# costs two things that matter:
#
#   1. Nothing restarts it. Noctalia is the bar, the launcher, the
#      notifications, the OSD and the lock screen; if it dies you lose all of
#      them at once and your only recovery is a TTY. Restart=on-failure fixes
#      that in place.
#   2. There is no unit to protect. systemd-oomd and earlyoom both need
#      something to point ManagedOOMPreference / OOMScoreAdjust at, and a bare
#      child of niri.service cannot be singled out.
#
# Wire it into the session with:
#     systemctl --user add-wants niri.service noctalia.service
[Unit]
Description=Noctalia desktop shell
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/noctalia
Restart=on-failure
RestartSec=2
# Losing the shell to reclaim memory is worse than almost anything it could be
# holding, so take it out of the running for both OOM killers.
ManagedOOMPreference=avoid
OOMScoreAdjust=-500

[Install]
WantedBy=graphical-session.target

# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# ---- Memory-conscious dev environment ----
export NODE_OPTIONS="--max-old-space-size=3072"
export NX_DAEMON=true
export DOTNET_gcServer=0
export DOTNET_CLI_TELEMETRY_OPTOUT=1

# Run a command in a memory-capped cgroup — use for heavy builds
capped() { systemd-run --user --scope -p MemoryMax=6G -p MemoryHigh=5G -p MemorySwapMax=2G "$@"; }

# ---- Aliases ----
alias cat='bat --paging=never'
alias top='btop'
alias ls='eza --icons --group-directories-first'
alias ll='eza -l -a --icons --git --group-directories-first'
alias la='eza -la --icons --git --group-directories-first'
alias lt='eza --tree --level=2 --git-ignore'
alias lS='eza --oneline'
alias help='tldr'

# ---- Memory & Docker helpers ----
alias mem='free -h && echo && zramctl'
alias memhogs='ps aux --sort=-%mem | head -12'
alias cgtop='systemd-cgtop -m'
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
alias dstats='docker stats --no-stream'
# NB: NO --volumes, and NO -a. `docker system prune` removes stopped containers
# FIRST, which orphans their named volumes; --volumes then deletes those orphans
# in the same command, and -f means there is no prompt. On this machine that is
# the Postgres, MinIO and Keycloak data. `-a` separately removes every image not
# backed by a RUNNING container, i.e. most of what you use weekly.
alias dprune='docker system prune -f && docker builder prune -f'
alias lzd='lazydocker'
# NB: `nx` is a per-workspace binary from node_modules/.bin, not a system
# package - this alias only resolves inside an Nx repo, and is deliberately not
# in packages/*.tsv for that reason.
alias nxr='nx reset'

# ---- PATH ----
# NB: prepend through this, never with a bare `export PATH="$dir:$PATH"`. A
# bare prepend is not idempotent, and this file gets re-sourced constantly -
# `exec zsh`, `source ~/.zshrc`, a nested login shell - each time growing PATH
# by another copy of every entry below.
path_prepend() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) export PATH="$1:$PATH" ;;
  esac
}

path_prepend "$HOME/.local/bin"

# npm's global prefix, set here rather than in ~/.npmrc.
#
# NB: ~/.npmrc is in home/.chezmoiignore under "Secrets" because it is where an
# auth token would land, so it is NOT source-controlled - which means a prefix
# written there would not survive a rebuild. The env var does the same job and
# stays in the repo. (On the Fedora machine the prefix lived in .npmrc and the
# PATH entry came from an untracked shell file, so `npm i -g` on a fresh box
# would have silently gone somewhere else.)
#
# NB: this is what keeps `npm i -g` out of /usr/lib/node_modules. That directory
# belongs to pacman's nodejs package; installing into it needs sudo and leaves
# files pacman will fight over on the next nodejs upgrade.
#
# NB: NPM_CONFIG_PREFIX is the one setting nvm and fnm refuse to start
# alongside - they manage the prefix themselves and abort with "nvm is not
# compatible with the npm config prefix". Nothing here uses either today; if a
# version manager ever arrives, this line is what has to go.
export NPM_CONFIG_PREFIX="$HOME/.npm-global"
path_prepend "$NPM_CONFIG_PREFIX/bin"

# pnpm's global prefix, same idea as NPM_CONFIG_PREFIX above and restored here
# after it went missing.
#
# NB: this block was dropped when the zshrc was brought into the repo, with no
# note, while pnpm was installed and in use - so applying the repo took `pnpm`
# off PATH entirely. Every other removal in that rewrite got an NB explaining
# itself; this one was an accident, which is how it was caught.
#
# NB: the PATH entry is $PNPM_HOME/bin, NOT $PNPM_HOME. That is where pnpm puts
# the shims (pnpm, pnpx, pn, pnx) and where `pnpm add -g` links binaries;
# prepending the parent finds nothing and looks exactly like pnpm not being
# installed.
export PNPM_HOME="$HOME/.local/share/pnpm"
path_prepend "$PNPM_HOME/bin"
